# Copier ce fichier vers .env et renseigner vos valeurs (Neon, JWT, etc.)

DATABASE_URL="postgresql://user:password@host/neondb?sslmode=require"
JWT_SECRET="your-jwt-secret-key"

FRONTEND_CLIENT_URL=http://localhost:5173
FRONTEND_ADMIN_URL=http://localhost:5174

RESEND_API_KEY="your-resend-api-key"
MAIL_FROM="TAOMAN <noreply@yourdomain.com>"

# Optionnel en local ; Render définit PORT automatiquement
# PORT=3000
