# Copier ce fichier vers .env et renseigner vos valeurs (Neon, JWT, etc.)

DATABASE_URL="postgresql://user:password@host/neondb?sslmode=require"
JWT_SECRET="your-jwt-secret-key"

FRONTEND_CLIENT_URL=https://www.taomaninvestment.com
FRONTEND_ADMIN_URL=https://taoman-admin-main.vercel.app
# Origines supplémentaires (séparées par des virgules), ex. preview Vercel
# CORS_EXTRA_ORIGINS=https://taoss-main.vercel.app,https://admin.example.com

RESEND_API_KEY="your-resend-api-key"
MAIL_FROM="TAOMAN <noreply@yourdomain.com>"

# Cloudinary (médias + sauvegardes) — ne jamais committer les secrets
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Alertes email admin (Resend)
ADMIN_ALERT_EMAIL=admin@example.com

# Optionnel en local ; Render définit PORT automatiquement
# PORT=3000
